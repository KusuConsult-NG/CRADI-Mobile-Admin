# Appwrite project (Appwrite console → Settings → the project's API endpoint
# and ID). The endpoint and project ID are public — access is enforced by the
# collections' permissions and by the `write` Function — but NEXT_PUBLIC_*
# values are embedded at BUILD time, so they must be set before `npm run build`.
#
# The endpoint must include the `/v1` path; without it every call 404s.
NEXT_PUBLIC_APPWRITE_ENDPOINT=https://<region>.cloud.appwrite.io/v1
NEXT_PUBLIC_APPWRITE_PROJECT_ID=
# Optional; defaults to `cradi`.
NEXT_PUBLIC_APPWRITE_DATABASE_ID=cradi

# Server-only: an API key used by /api/admin/* routes (approve, block, delete
# users, change roles) and scripts/set-admin.mjs. It bypasses every permission.
# Scopes needed: users.read, users.write, tables.read, tables.write (or
# `documents.read` / `documents.write` on older servers).
# NEVER expose it to the browser or commit a real value.
APPWRITE_API_KEY=

# Optional server-side overrides; each falls back to the NEXT_PUBLIC_ value
# above, so set them only when the server must reach Appwrite at a different
# address (e.g. an internal URL inside the same network).
# APPWRITE_ENDPOINT=
# APPWRITE_PROJECT_ID=
# APPWRITE_DATABASE_ID=cradi
