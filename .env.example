# Supabase project (Project Settings → API). The URL and anon key are public
# (data access is enforced by Row Level Security) but NEXT_PUBLIC_* values are
# embedded at BUILD time, so they must be set before `npm run build`.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only: service role key used by /api/admin/* routes (approve, block,
# delete users, change roles) and scripts/set-admin.mjs. Bypasses RLS.
# NEVER expose it to the browser or commit a real value.
SUPABASE_SERVICE_ROLE_KEY=
